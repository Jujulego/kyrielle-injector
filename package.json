{
  "name": "@kyrielle/injector",
  "version": "1.1.0",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jujulego/kyrielle-injector"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "jill run 'build:esm // build:types'",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run --typecheck",
    "test:types": "tsc --project tests"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@jujulego/jill": "3.0.9",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.24",
    "@types/node": "24.12.2",
    "@typescript-eslint/utils": "8.58.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "1.6.14",
    "eslint": "9.39.4",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.6"
  },
  "packageManager": "yarn@4.12.0",
  "dependenciesMeta": {
    "vitest@3.2.6": {
      "unplugged": true
    }
  }
}
