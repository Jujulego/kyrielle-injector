{
  "name": "@kyrielle/injector",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jujulego/kyrielle-injector"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "jill run 'build:esm // build:types'",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.3"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@jujulego/jill": "2.5.2",
    "@jujulego/vite-plugin-swc": "1.2.0",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.7.8",
    "@swc/core": "1.13.3",
    "@types/eslint__js": "8.42.3",
    "@types/node": "20.19.11",
    "@typescript-eslint/utils": "8.39.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/eslint-plugin": "1.3.4",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "shx": "0.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vite": "7.1.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.9"
  },
  "dependenciesMeta": {
    "vitest@2.1.9": {
      "unplugged": true
    }
  },
  "packageManager": "yarn@4.5.1"
}
