{
  "name": "@kyrielle/injector",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jujulego/kyrielle-injector.git"
  },
  "description": "Lightweight dependency injection tools",
  "keywords": [
    "kyrielle",
    "dependency injection",
    "di"
  ],
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "type": "module",
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    ".": {
      "types": "./dist/node.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "jill run 'build:esm // build:types'",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run --typecheck",
    "test:types": "tsc --project tests"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jujulego/jill": "3.1.0",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.71.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.18.1"
}
